# IELTS Cockpit 环境配置（复制为 .env 后填写）
# 复制本文件为 .env：cp .env.example .env

# ===== 服务配置 =====
# 监听端口（默认 3000）
PORT=3000

# ===== AI 评分（可选，不配也能用基础功能）=====
# 以下以阿里云百炼为例（开通地址：https://bailian.console.aliyun.com/）
# 任何兼容 OpenAI 接口的服务均可对接，需自行改 server/services/ 里的 baseURL
DASHSCOPE_API_KEY=
# 文本评分模型（写作批改、周报建议）
LLM_MODEL=qwen-max
# 口语音频评分模型（必须支持直接输入音频，否则发音维度不可靠）
OMNI_MODEL=qwen3.5-omni
# Task1 图表读图模型（多模态）
VISION_MODEL=qwen-vl-plus

# ===== 本地语音识别（可选，辅助/降级）=====
# Python 可执行文件路径（留空自动检测）
PYTHON_PATH=
# faster-whisper 模型目录（留空用默认下载位置）
WHISPER_MODEL_DIR=
