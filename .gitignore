# ===== 依赖 =====
node_modules/

# ===== 环境变量（含 API key，务必不要提交）=====
.env
.env.local
.env.*.local

# ===== 个人数据保护 =====
# 数据文件由程序在本机创建，整个 data/ 目录不提交。
data/*
!data/.gitkeep

# 用户上传的音频 / 图片
uploads/*
!uploads/.gitkeep

# ===== 日志 =====
*.log
npm-debug.log*

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器 =====
.vscode/
.idea/
*.swp
